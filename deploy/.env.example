# Compose project and public HTTPS identity.
COMPOSE_PROJECT_NAME=dca-terminal
APP_DOMAIN=invest.example.com
CADDY_EMAIL=ops@example.com

# PostgreSQL 18.6 is the default. Major-version data directories are not
# compatible; use the documented dump/restore procedure when upgrading.
POSTGRES_IMAGE=postgres:18.6-alpine
CADDY_IMAGE=caddy:2-alpine

# Replace the database password and application password hash before deployment.
POSTGRES_DB=dca_terminal
POSTGRES_USER=dca_terminal
POSTGRES_PASSWORD=replace-before-starting
APP_USERNAME=admin
APP_PASSWORD_HASH=replace-with-bcrypt-hash
DATABASE_POOL_SIZE=10

# The browser uses the same origin through Caddy.
VITE_API_BASE_URL=/api/v1
# live is the default. Use demo only for an explicitly non-account local preview.
VITE_APP_MODE=live
SPRING_PROFILES_ACTIVE=prod
APP_THEME=System
APP_SECURITY_ENABLED=true
APP_COOKIE_SECURE=true
# Keep a successfully authenticated device signed in for up to one year.
# The session itself is stored in PostgreSQL, so API/container restarts do not
# force a new login. Explicit logout still invalidates it immediately.
APP_SESSION_MAX_AGE_SECONDS=31536000
# Spring reads these from the API process environment. The current compose
# file uses application.yml defaults (5 / 900) unless the API service
# environment is extended to pass them through.
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_THROTTLE_WINDOW_SECONDS=900
FLYWAY_ENABLED=true
MARKET_SYNC_ENABLED=true
MARKET_SYNC_CRON=0 30 18 * * MON-FRI

# Market data configuration. Keys stay on the API container and are never sent to web.
MARKET_DATA_PRIMARY_PROVIDER=YAHOO
MARKET_DATA_FALLBACK_PROVIDER=TWELVE_DATA
# Optional HTTP proxy for Yahoo. In Docker on Linux, a host proxy can use
# http://host.docker.internal:7890; leave empty when direct egress is allowed.
YAHOO_PROXY_URL=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Host-side backup policy used by deploy/scripts/*.sh.
BACKUP_DIR=deploy/backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_WEEKLY_DAY=7
